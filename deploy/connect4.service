# Systemd unit for running the Connect 4 FastAPI backend on a Linux VPS
# Install to: /etc/systemd/system/connect4.service
# Enable:     sudo systemctl daemon-reload && sudo systemctl enable --now connect4

[Unit]
Description=Connect 4 (WeakC4) FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/connect4/backend
EnvironmentFile=-/var/www/connect4/backend/.env
Environment="MAX_AI_DEPTH=4"
# Use --workers 1 so in-memory game sessions & Admin SSE streams share one process.
ExecStart=/var/www/connect4/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
